# AI Studio cloud backend configuration.
# Copy to .env and fill in. [REQUIRED] = must be set in every environment;
# [PROD] = must be set when NODE_ENV=production; everything else has a default.

# --- Server ---
PORT=5000                      # default 5000
NODE_ENV=development           # development | production | test

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/ai_image_studio   # [REQUIRED]

# --- Auth ---
# [REQUIRED] Two different random secrets, at least 32 characters each.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_1
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET_2
JWT_ACCESS_EXPIRES=15m         # default 15m
JWT_REFRESH_EXPIRES=60d        # default 60d
BCRYPT_SALT=12                 # default 12

# --- Credits ---
FREE_CREDITS=10                # credits granted at sign-up, default 10

# --- Vast.ai GPU rental ---
VASTAI_API_KEY=your_vastai_api_key           # without it, GPU rental is unavailable
VASTAI_API_BASE=https://console.vast.ai/api/v0   # default shown

# --- Media storage ---
MEDIA_STORAGE_PATH=/var/www/media            # default /var/www/media
MEDIA_PUBLIC_URL=https://example.com/media   # public base URL for MEDIA_STORAGE_PATH

# --- Moderation (Google Cloud Vision) ---
# Path to a service-account JSON key. GOOGLE_CLOUD_KEYFILE is accepted as an alias;
# GCP_SERVICE_ACCOUNT_KEY may hold the key inline instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_KEYFILE=
# GCP_SERVICE_ACCOUNT_KEY=
# Lets QA requests force a moderation verdict via a header. Never enable in production.
ALLOW_TEST_MODERATION_OVERRIDE=false

# --- Cloudflare R2 model weights storage (S3-compatible) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
# Read/write key (admin uploads)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Read-only key (downloads)
R2_READONLY_ACCESS_KEY_ID=your_r2_readonly_access_key_id
R2_READONLY_SECRET_ACCESS_KEY=your_r2_readonly_secret_access_key
