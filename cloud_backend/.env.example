PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ai_image_studio

# JWT Secrets (Minimum 32 characters for security)
JWT_ACCESS_SECRET=supersecret_access_jwt_key_ai_image_studio_2026_secure
JWT_REFRESH_SECRET=supersecret_refresh_jwt_key_ai_image_studio_2026_secure
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Security & Credits
BCRYPT_SALT=12
FREE_CREDITS=10

# Cloudflare R2 model weights storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cosmic-gen-models
